# Copy to .env.local for local dev. In Vercel: Project → Settings → Environment Variables.
# All are server-only. Never prefix with NEXT_PUBLIC_.
# Quote any value that contains # or spaces, e.g. SITE_PASSWORD="fiesta #1"

# Airtable (Phase 2)
# personal access token, scoped to the base (read + write records)
AIRTABLE_TOKEN=
# starts with "app", from the base URL: airtable.com/appXXXXXXXX/...
AIRTABLE_BASE_ID=

# Access control
# shared password printed on the invitation (matched case-insensitively)
SITE_PASSWORD=
# host + engineer only (Phase 4)
ADMIN_PASSWORD=
# 32+ random chars: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
